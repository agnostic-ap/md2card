## Landing page
## Set to "true" only on the hosted service — self-hosted deployments go straight to the editor
VITE_LANDING_ENABLED=false

## Backend API
VITE_API_BASE=http://127.0.0.1:3747

## Analytics
## none | ga | plausible
VITE_ANALYTICS_PROVIDER=none
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=

## Ads
VITE_ADS_ENABLED=true
VITE_AD_CLICK_URL=#/app
VITE_AD_TITLE=把下一篇内容做成一组卡片
VITE_AD_DESCRIPTION=MD2Card 支持 Markdown 写作、AI 成稿、主题模板和多格式导出。
