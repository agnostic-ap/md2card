# 前端生产环境变量模板
# 复制此文件为 .env.production，由 Vite 在构建时读取（不会打包进代码）

# 后端 API 地址
# 生产环境由 Nginx 反代，留空即可（使用相对路径 /api/...）
VITE_API_BASE=

## 统计分析
## none | ga | plausible
VITE_ANALYTICS_PROVIDER=none
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=

## 广告位（不需要可设为 false）
VITE_ADS_ENABLED=false
VITE_AD_CLICK_URL=#/app
VITE_AD_TITLE=
VITE_AD_DESCRIPTION=
