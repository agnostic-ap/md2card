# MD2Card Nginx 站点配置模板
# 使用前将所有 YOUR_DOMAIN 替换为实际域名，如：md2card.example.com
# 部署到：/etc/nginx/sites-available/md2card

# HTTP → HTTPS 强制跳转
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    # Let's Encrypt ACME 验证路径（certbot 需要）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS 主站
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name YOUR_DOMAIN;

    # SSL 证书（由 certbot 生成）
    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # 静态资源根目录（Vite 构建产物）
    root  /var/www/md2card/front/dist;
    index index.html;

    # 日志
    access_log /var/log/nginx/md2card.access.log;
    error_log  /var/log/nginx/md2card.error.log;

    # Gzip 压缩
    gzip            on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff2;

    # 静态资源长缓存（文件名含 hash，Vite 已处理）
    location ~* \.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|webp|ico)$ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 后端 API 反向代理
    location /api/ {
        proxy_pass         http://127.0.0.1:3747;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # SPA 回退：所有非文件路径返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 安全响应头
    add_header X-Content-Type-Options  "nosniff"        always;
    add_header X-Frame-Options         "SAMEORIGIN"     always;
    add_header X-XSS-Protection        "1; mode=block"  always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;

    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
    }
}
