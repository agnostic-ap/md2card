# LLM：任选其一填写 OPENAI_API_KEY / DASHSCOPE_API_KEY（通义）/ ARK_API_KEY（火山方舟）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# 可选：若厂商路径特殊，可写完整 URL 或相对路径（见 README「国内厂商」）
# OPENAI_CHAT_COMPLETIONS_PATH=

# 是否使用系统代理（HTTP_PROXY 等）。国内网络若遇 Connection reset，可保持 false
HTTP_TRUST_PROXY=false

# --- 通义千问（阿里云 DashScope OpenAI 兼容）示例 ---
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
# DASHSCOPE_API_KEY=你的DashScopeKey

# --- 豆包（火山方舟 OpenAI 兼容）示例：model 填控制台「推理接入点」ID ---
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=ep-xxxxxxxx
# ARK_API_KEY=你的ArkKey

MD2CARD_API_KEY=your_md2card_key
MD2CARD_THEME=xiaohongshu
MD2CARD_THEME_MODE=
MD2CARD_SPLIT_MODE=autoSplit
MD2CARD_OVER_HIDDEN_MODE=false
MD2CARD_WIDTH=440
MD2CARD_HEIGHT=586
